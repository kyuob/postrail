{
  "name": "postrail",
  "version": "0.0.0",
  "description": "A Markdown publishing CLI project for Velog, Tistory, and KeyFlow.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyuob/postrail.git"
  },
  "homepage": "https://github.com/kyuob/postrail#readme",
  "bugs": {
    "url": "https://github.com/kyuob/postrail/issues"
  },
  "bin": {
    "postrail": "./dist/cli.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun src/cli.js",
    "build": "bun build src/cli.js --target=node --outdir=dist",
    "smoke": "bun scripts/smoke.mjs",
    "check": "bun run build && bun run smoke"
  }
}
