{
  "name": "postrail",
  "version": "0.0.0",
  "description": "A Markdown publishing CLI project for Velog, Tistory, KeyFlow, and Google Blogger.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyuob/postrail.git"
  },
  "homepage": "https://github.com/kyuob/postrail#readme",
  "bugs": {
    "url": "https://github.com/kyuob/postrail/issues"
  },
  "bin": {
    "postrail": "./dist/cli.js"
  },
  "files": ["dist/cli.js", "README.md", "LICENSE", "docs", "examples"],
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun src/cli.js",
    "build": "bun build src/cli.js --target=node --outdir=dist",
    "smoke": "bun scripts/smoke.mjs",
    "test": "node --test scripts/core.test.mjs scripts/keyflow.test.mjs",
    "check:offline": "bun run build && bun run smoke && node --test scripts/core.test.mjs",
    "check": "bun run build && bun run smoke && bun run test"
  },
  "dependencies": {
    "@keyflow-blog/cli": "2026.10.20",
    "markdown-it": "15.0.3",
    "yaml": "2.9.1"
  }
}
